scripts/.local/bin/ruff
scripts/.local/bin/ty
scripts/.local/bin/black
scripts/.local/bin/blackd

# Sensitive
.ssh/
.boto

# Password store (separate repo)
.password-store/

# IPython auto-generated
history.sqlite

# Dotfiles repo itself (when stowed to ~)
/dotfiles/
