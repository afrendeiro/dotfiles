# Local secrets / machine-specific settings
*.local
!scripts/.local/
*.local.fish
fish_variables
local.fish

# Auto-generated files
lazy-lock.json

# nwg-displays generated monitor configs (machine-specific)
hyprland/.config/hypr/monitors.conf
hyprland/.config/hypr/monitors.lua
hyprland/.config/hypr/workspaces.conf

# Tool binaries installed by bootstrap scripts
scripts/.local/bin/btop
scripts/.local/bin/herdr
scripts/.local/bin/uv
scripts/.local/bin/uvx
scripts/.local/bin/llm

# Sensitive
.ssh/
.boto

# Password store (separate repo)
.password-store/

# IPython auto-generated
history.sqlite

# Dotfiles repo itself (when stowed to ~)
/dotfiles/
