{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "matugen",
    "mode": "system"
  },
  "diffs": {
    "wrap": "word"
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": true,
    "thinking": "hide",
    "markdown": "rendered",
    "grouping": "auto",
    "image_preview": false,
    "tps": true,
    "new_location": "launch",
    "permissions": "prompt"
  },
  "animations": true,
  "tabs": {
    "enabled": true,
    "scope": "global",
    "layout": "horizontal",
    "indicators": "status"
  },
  "attention": {
    "sound": false,
    "notifications": false
  }
}
