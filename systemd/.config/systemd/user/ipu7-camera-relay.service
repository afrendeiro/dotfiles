[Unit]
Description=IPU7 camera relay (libcamera -> v4l2loopback)
# GStreamer relays the libcamera soft-ISP output to a v4l2loopback device so
# browsers/desktop apps see a normal webcam. Started on demand by
# ipu7-camera-watch.service (replacing ipu7-camera-proxy while the camera is
# in use). Caps match the proxy's (YUYV 1280x720) so consumers never see a
# mid-stream format change. StartLimit disabled: the watchdog restarts this
# unit on every poll while a consumer is attached. See notes/camera-ipu7.md.
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=/usr/bin/gst-launch-1.0 libcamerasrc ! videoflip method=rotate-180 ! videoconvert ! video/x-raw,format=YUY2,width=3840,height=2160,framerate=30/1 ! v4l2sink device=/dev/video33
Restart=always
RestartSec=2
Environment=LIBCAMERA_LOG_LEVELS=*:ERROR

[Install]
WantedBy=default.target
